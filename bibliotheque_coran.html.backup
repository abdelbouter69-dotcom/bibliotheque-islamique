     {num:3,labelAr:'المَرْحَلَةُ الثَّالِثَة — الإِتْقَان',labelFr:'Expert',badge:'Expert',numBg:'#534AB7',badgeC:'#EEEDFE',badgeTxt:'#3C3489',
      books:[
        {n:1,ar:'الدُّرُّ المَصُونُ فِي عُلُومِ الكِتَابِ المَكْنُون',auth:'السمين الحلبي (ت.756هـ)',desc:'Encyclopédie de l\'analyse grammaticale — 11 volumes.',bg:'linear-gradient(135deg,#7F77DD,#534AB7)',yt:'https://www.youtube.com/results?search_query=الدر+المصون+السمين+الحلبي',sh:'https://shamela.ws/search?q=الدر+المصون+السمين+الحلبي'},
        {n:2,ar:'إِعْرَابُ القُرْآن',auth:'النحاس (ت.338هـ)',desc:'L\'une des premières références classiques.',bg:'linear-gradient(135deg,#3C3489,#26215C)',yt:'https://www.youtube.com/results?search_query=إعراب+القرآن+النحاس',sh:'https://shamela.ws/search?q=إعراب+القرآن+النحاس'},
